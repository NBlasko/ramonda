# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
# The production test run writes here (core, query, lens): `__DEV__` is baked in per
# process, so production-only code needs its own pass, and its own report to merge.
coverage-prod

# What a browser run leaves behind: a trace and a screenshot per failure, and the HTML report that
# reads them. Written only when something fails, and worth looking at on the machine that produced
# it rather than committing.
apps/playground-core/test-results/
apps/playground-core/playwright-report/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# `build` above matches any directory of that name, and one of them is a package rather than an
# output. Re-included by name, so its source is tracked; anything it emits is caught by `dist`.
!packages/build


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# apps/docs build artefacts
apps/docs/dist/
apps/docs/.build/
apps/docs/src/generated/

# `css-system/` — written by `ramonda-css codegen` — is COMMITTED, and the argument for hiding it was
# wrong. It said committing would let a config and its output drift apart in review; this repository
# answers that with a gate rather than by hiding, which is why `keywords.generated.ts` is in the tree
# and `build-css-properties.mjs --check` fails when it is stale. Hiding the file does not prevent
# drift, it prevents anybody SEEING it — and it costs a fresh clone its `$` until something builds.

# The packaged editor extension. Built from the folder it sits in, on the way to a marketplace or an
# editor, and never a source of anything — a committed one is a binary nobody can review or diff.
*.vsix

# Internal working notes — kept local, not for the public repo
notes/

# Local agent configuration and skills — machine-local, like notes/.
.claude/
