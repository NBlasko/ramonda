{
  "name": "ramonda-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/entry-client.tsx --bundle --format=esm --jsx-factory=h --inject:./jsx-shim.ts --conditions=production --target=es2022 --outfile=dist/client/assets/client.js",
    "build:server": "esbuild src/entry-server.tsx --bundle --format=esm --jsx-factory=h --inject:./jsx-shim.ts --conditions=production --platform=node --target=es2022 --outfile=dist/server/entry-server.js",
    "build": "npm run build:client && npm run build:server",
    "start": "node server.mjs",
    "dev": "npm run build && npm run start"
  }
}
