{
  "name": "create-ramonda",
  "version": "0.9.0",
  "description": "Scaffold a Ramonda app — pick your packages and rendering mode, then just run it.",
  "type": "module",
  "bin": {
    "create-ramonda": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "verify-versions": "node scripts/verify-versions.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "ramonda",
    "create",
    "scaffold",
    "starter",
    "template",
    "cli"
  ],
  "author": "Nikola Blagojević",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/create-ramonda"
  },
  "homepage": "https://ramonda.pages.dev",
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
