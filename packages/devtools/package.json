{
  "name": "@ramonda/devtools",
  "version": "0.5.0",
  "description": "Development-time devtools panel for Ramonda — component tree, state, and logs.",
  "license": "MIT",
  "author": "Nikola Blagojević",
  "homepage": "https://ramonda.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "keywords": [
    "ramonda",
    "devtools"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && ramonda-check-bundle dist",
    "check-types": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --watch",
    "lint": "oxlint src",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@ramonda/lens": "workspace:^",
    "@ramonda/shared": "workspace:^",
    "@ramonda/theme": "workspace:^",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.1",
    "jsdom": "28.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
