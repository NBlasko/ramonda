{
  "name": "@ramonda/testing-library",
  "version": "0.3.0",
  "description": "Testing utilities for Ramonda components and hooks, built on @testing-library/dom.",
  "license": "MIT",
  "author": "Nikola Blagojević",
  "homepage": "https://ramonda.dev/testing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/testing-library"
  },
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "keywords": [
    "ramonda",
    "testing",
    "testing-library",
    "test"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dont-cleanup-after-each": {
      "import": "./dist/dont-cleanup-after-each.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && ramonda-check-bundle dist",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "biome format --write src"
  },
  "peerDependencies": {
    "@ramonda/core": ">=0.0.2 <1.0.0"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1"
  },
  "devDependencies": {
    "@ramonda/check": "workspace:^",
    "@ramonda/core": "workspace:^",
    "@ramonda/devtools": "workspace:^",
    "@types/node": "^26.1.2",
    "jsdom": "28.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
