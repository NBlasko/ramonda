{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    // `node` for the surface test alone, which reads the emitted `.d.ts` off disk — the
    // published declarations are a file, so asserting about them means opening one.
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "env.d.ts"]
}
