{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "@ramonda/core",
    "types": ["vitest/globals"],
    "paths": {
      "@ramonda/core/jsx-runtime": ["../core/src/jsx-runtime.ts"],
      "@ramonda/core/jsx-dev-runtime": ["../core/src/jsx-dev-runtime.ts"],
      "@ramonda/core": ["../core/src/index.ts"],
      "@ramonda/core/testing": ["../core/src/testing.ts"],
      "@ramonda/testing-library": ["../testing-library/src/index.ts"]
    }
  },
  "include": ["src", "global.d.ts"]
}
