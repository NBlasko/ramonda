{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "h",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@ramonda/core": ["../core/src/index.ts"],
      "@ramonda/core/testing": ["../core/src/testing.ts"],
      "@ramonda/testing-library": ["../testing-library/src/index.ts"]
    }
  },
  "include": ["src", "global.d.ts"]
}
