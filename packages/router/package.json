{
  "name": "@ramonda/router",
  "version": "0.2.0",
  "description": "Client-side router for Ramonda: state-first, race-free navigation with nested route outlets.",
  "license": "MIT",
  "author": "Nikola Blagojević",
  "homepage": "https://ramonda.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/router"
  },
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "keywords": [
    "ramonda",
    "router",
    "routing",
    "spa",
    "navigation"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": "./dist/server.browser.js",
      "import": "./dist/server.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && ramonda-check-bundle dist",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "biome format --write src"
  },
  "devDependencies": {
    "@ramonda/shared": "workspace:^",
    "@ramonda/testing-library": "workspace:^",
    "@types/node": "^26.1.2",
    "jsdom": "28.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@ramonda/core": ">=0.1.0 <1.0.0"
  }
}
