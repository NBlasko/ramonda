{
  "name": "@ramonda/build",
  "version": "0.3.0",
  "description": "The bundler settings a Ramonda app needs, as a Vite plugin and an esbuild plugin — so the app names none of them.",
  "license": "MIT",
  "author": "Nikola Blagojević",
  "homepage": "https://ramonda.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/build"
  },
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "ramonda",
    "vite",
    "esbuild",
    "plugin",
    "decorators",
    "build"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && ramonda-check-bundle dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "biome format --write src"
  },
  "devDependencies": {
    "@ramonda/check": "workspace:^",
    "@types/node": "^26.2.0",
    "esbuild": "0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
