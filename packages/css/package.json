{
  "name": "@ramonda/css",
  "version": "0.8.0",
  "description": "A style block written in real CSS beside the markup, compiled to classes before the build.",
  "license": "MIT",
  "author": "Nikola Blagojević",
  "homepage": "https://ramonda.dev/style-blocks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/css"
  },
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "css",
    "compiler",
    "atomic-css",
    "custom-properties",
    "type-safe"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "development": "./dist/index.js",
        "production": "./dist/index.prod.js",
        "default": "./dist/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      },
      "default": "./dist/config.cjs"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./properties": {
      "types": "./dist/properties.d.ts",
      "import": "./dist/properties.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "require": "./dist/plugin.cjs",
      "default": "./dist/plugin.cjs"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "import": "./dist/prettier.js"
    }
  },
  "bin": {
    "ramonda-css": "./bin.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "bin.mjs",
    "plugin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "biome format --write src"
  },
  "dependencies": {
    "magic-string": "^1.4.3"
  },
  "peerDependencies": {
    "prettier": "^3",
    "typescript": ">=5.4.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "shiki": "^4.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vite-7": "npm:vite@7.3.6",
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  }
}
