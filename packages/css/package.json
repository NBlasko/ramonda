{
  "name": "@ramonda/css",
  "version": "0.0.0",
  "private": true,
  "description": "A style block written in real CSS beside the markup, compiled to a class and custom properties.",
  "license": "MIT",
  "author": "Nikola Blagojević",
  "homepage": "https://ramonda.dev/css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/css"
  },
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "keywords": [
    "css",
    "compiler",
    "atomic-css",
    "custom-properties",
    "type-safe"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "development": "./dist/index.js",
        "production": "./dist/index.prod.js",
        "default": "./dist/index.js"
      }
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "biome format --write src"
  },
  "dependencies": {
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
