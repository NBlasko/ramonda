{
  "name": "css",
  "displayName": "Ramonda CSS",
  "description": "Real CSS beside your markup: syntax colouring, formatting and diagnostics for @@( \u2026 ) style blocks.",
  "version": "0.1.2",
  "private": true,
  "publisher": "ramonda",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "ramonda.css-block",
        "path": "./grammar/ramonda-css.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.css": "css"
        }
      },
      {
        "scopeName": "ramonda.css-hole",
        "path": "./grammar/ramonda-css-hole.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx",
          "source.css"
        ],
        "embeddedLanguages": {
          "meta.embedded.expression.tsx": "typescriptreact"
        }
      },
      {
        "scopeName": "ramonda.css-value",
        "path": "./grammar/ramonda-css-value.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.css": "css"
        }
      }
    ]
  },
  "main": "./formatter.js",
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/css/vscode"
  },
  "homepage": "https://ramonda.dev/style-blocks",
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "author": "Nikola Blagojevi\u0107",
  "keywords": [
    "css",
    "eteti",
    "style blocks",
    "css-in-js",
    "atomic-css",
    "syntax-highlighting",
    "typescript"
  ],
  "scripts": {
    "install-locally": "node install.mjs",
    "package": "pnpm dlx @vscode/vsce@3 package --no-dependencies --out ramonda-css.vsix",
    "publish-marketplace": "pnpm dlx @vscode/vsce@3 publish --no-dependencies"
  }
}
