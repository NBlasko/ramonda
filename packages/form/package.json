{
  "name": "@ramonda/form",
  "version": "0.0.0",
  "description": "Forms for Ramonda: typed field paths, Standard Schema validation, and rows that keep their identity.",
  "license": "MIT",
  "author": "Nikola Blagojevi\u0107",
  "homepage": "https://ramonda.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/form"
  },
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "keywords": [
    "ramonda",
    "form",
    "validation",
    "standard-schema",
    "bguard"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "development": "./dist/index.js",
        "production": "./dist/index.prod.js",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && ramonda-check-bundle dist",
    "dev": "tsup --watch",
    "test": "vitest run --coverage && pnpm test:prod",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "biome format --write src",
    "test:prod": "NODE_ENV=production vitest run --config vitest.prod.config.ts --coverage --coverage.reportsDirectory=coverage-prod"
  },
  "devDependencies": {
    "@ramonda/shared": "workspace:^",
    "@ramonda/testing-library": "workspace:^",
    "jsdom": "28.0.0",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.10",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "@ramonda/core": ">=0.1.0 <1.0.0"
  }
}
