{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "..",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ramonda/core": ["../framework.ts"]
    },
    "paths": {
      "@ramonda/router": ["./self.ts"]
    }
  },
  "include": [".", "../framework.ts", "../jsx-runtime.ts"]
}
