{
  "name": "@ramonda/check",
  "version": "0.0.0",
  "description": "Static checks for a Ramonda app \u2014 proves a context consumer has a provider above it, before the page is ever opened.",
  "license": "MIT",
  "author": "Nikola Blagojevi\u0107",
  "homepage": "https://ramonda.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBlasko/ramonda.git",
    "directory": "packages/check"
  },
  "bugs": {
    "url": "https://github.com/NBlasko/ramonda/issues"
  },
  "keywords": [
    "ramonda",
    "static-analysis",
    "context",
    "lint",
    "cli"
  ],
  "type": "module",
  "bin": {
    "ramonda-check-context": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "biome format --write src"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
