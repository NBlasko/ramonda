{
  "name": "@ramonda/playground-ssr",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server && ramonda-check-bundle dist",
    "build:client": "esbuild src/entry-client.tsx --bundle --format=esm --jsx=automatic --jsx-import-source=@ramonda/core --define:__DEV__=true --sourcemap=inline --target=es2022 --alias:@ramonda/query/devtools=../../packages/query/src/devtools.ts --alias:@ramonda/form/devtools=../../packages/form/src/devtools.ts --alias:@ramonda/core/jsx-dev-runtime=../../packages/core/src/jsx-dev-runtime.ts --alias:@ramonda/core/jsx-runtime=../../packages/core/src/jsx-runtime.ts --alias:@ramonda/core=../../packages/core/src/index.ts --alias:@ramonda/router=../../packages/router/src/index.ts --alias:@ramonda/query=../../packages/query/src/index.ts --alias:@ramonda/form=../../packages/form/src/index.ts --alias:@ramonda/devtools=../../packages/devtools/src/index.ts --outfile=dist/client/assets/client.js && node -e \"const fs=require('fs');fs.mkdirSync('dist/client',{recursive:true});fs.writeFileSync('dist/client/index.html',fs.readFileSync('index.html','utf8').replace('/src/entry-client.tsx','/assets/client.js'))\"",
    "build:server": "esbuild src/entry-server.tsx --bundle --format=esm --jsx=automatic --jsx-import-source=@ramonda/core --define:__DEV__=true --target=es2022 --alias:@ramonda/core/jsx-dev-runtime=../../packages/core/src/jsx-dev-runtime.ts --alias:@ramonda/core/jsx-runtime=../../packages/core/src/jsx-runtime.ts --alias:@ramonda/core=../../packages/core/src/index.ts --alias:@ramonda/router/server=../../packages/router/src/server.ts --alias:@ramonda/router=../../packages/router/src/index.ts --alias:@ramonda/query=../../packages/query/src/index.ts --alias:@ramonda/form=../../packages/form/src/index.ts --platform=node --alias:@ramonda/devtools=./devtools-stub.ts --outfile=dist/server/entry-server.js",
    "prerender": "npm run build:server && node scripts/prerender.mjs",
    "dev": "npm run build && node server.mjs",
    "start": "node server.mjs",
    "test": "npm run build && npm run prerender && npm run check:ssr-diagnostics && node scripts/smoke.mjs",
    "check-types": "tsc --noEmit",
    "build:diagnostics-fixture": "esbuild diagnostics-fixture.tsx --bundle --format=esm --jsx=automatic --jsx-import-source=@ramonda/core --define:__DEV__=true --target=es2022 --platform=node --alias:@ramonda/core/jsx-dev-runtime=../../packages/core/src/jsx-dev-runtime.ts --alias:@ramonda/core/jsx-runtime=../../packages/core/src/jsx-runtime.ts --alias:@ramonda/core=../../packages/core/src/index.ts --alias:@ramonda/devtools=./devtools-stub.ts --outfile=dist/server/diagnostics-fixture.js",
    "check:ssr-diagnostics": "npm run build:diagnostics-fixture && node scripts/diagnostics.mjs"
  },
  "dependencies": {
    "@ramonda/core": "workspace:^",
    "@ramonda/form": "workspace:^",
    "@ramonda/query": "workspace:^",
    "@ramonda/router": "workspace:^",
    "@ramonda/server": "workspace:^"
  },
  "devDependencies": {
    "@ramonda/check": "workspace:^",
    "@ramonda/devtools": "workspace:^",
    "@types/node": "^26.1.2",
    "esbuild": "0.28.1",
    "jsdom": "28.0.0",
    "launch-editor": "^2.12.0",
    "linkedom": "^0.18.13"
  }
}
